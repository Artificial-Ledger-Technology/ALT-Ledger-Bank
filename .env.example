# ══════════════════════════════════════════════════════════════
# ALT-Ledger-Bank — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit the .env file. It is excluded via .gitignore.
# ══════════════════════════════════════════════════════════════

# ── Blockchain ────────────────────────────────────────────────
# RPC endpoint for Sepolia testnet (Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Wallet private key for contract deployment (NEVER use a mainnet key with funds here)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── API Keys ──────────────────────────────────────────────────
# Etherscan API key for contract source verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# CoinMarketCap API key for gas reporter USD conversion (optional)
CMC_API_KEY=YOUR_CMC_KEY

# ── Feature Flags ─────────────────────────────────────────────
# Set to "true" to enable Hardhat gas reporter output
REPORT_GAS=false

# ── Frontend (Next.js — must be prefixed with NEXT_PUBLIC_) ──
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_ALT_TOKEN_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_LENDING_POOL_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_PRICE_ORACLE_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WC_PROJECT_ID
